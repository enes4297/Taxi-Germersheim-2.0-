---
/**
 * Hilfe und Kontakt — unter derselben Adresse wie bisher
 * (hilfe-kontakt.html).
 *
 * Inhalt wortgleich aus dem Bestand: vier Kontaktwege, ACHT haeufige Fragen
 * (nicht die sechs der Startseite - siehe FAQ_HILFE in inhalte.ts) und die
 * beiden Rechtsverweise.
 *
 * Die haeufigen Fragen sind hier als <details>/<summary> gebaut und NICHT
 * als Schaltflaechen mit Skript wie auf der Startseite. Zwei Gruende: Der
 * Bestand hatte sie ebenfalls als <details>, und ohne Skript lassen sie sich
 * auch dann oeffnen, wenn JavaScript scheitert - auf einer Hilfeseite zaehlt
 * das mehr als eine weiche Animation. Tastaturbedienung und Vorlesen bringt
 * der Browser dabei von sich aus mit.
 *
 * ZUSTIMMUNGSBANNER: nicht uebernommen. „Route anzeigen" ist ein
 * gewoehnlicher Verweis auf die Google-Kartensuche, keine Einbettung - es
 * wird nichts nachgeladen, solange niemand klickt. Siehe
 * ABSCHLUSS-OEFFENTLICHE-WEBSEITE.md, Abschnitt 9.2.
 */
import Grundlage from '../layouts/Grundlage.astro';
import Kopfbereich from '../components/Kopfbereich.astro';
import Fusszeile from '../components/Fusszeile.astro';
import Sprungmarken from '../components/Sprungmarken.astro';
import Unterseitenkopf from '../components/Unterseitenkopf.astro';
import Enthuellen from '../components/Enthuellen.astro';
import Symbol from '../components/Symbol.astro';
import { DATENSCHUTZ, FAQ_HILFE, FIRMA, HILFE, IMPRESSUM } from '../inhalte';

const wege = [
  {
    label: 'Telefon',
    wert: HILFE.telefonAnzeige,
    text: 'Rufen Sie uns direkt an.',
    href: FIRMA.telefonLink,
    aktion: 'Jetzt anrufen',
    symbol: 'telefon',
    extern: false,
  },
  {
    label: 'WhatsApp',
    wert: 'Direkt schreiben',
    text: 'Schreiben Sie uns direkt über WhatsApp Business.',
    href: FIRMA.whatsapp,
    aktion: 'WhatsApp öffnen',
    symbol: 'whatsapp',
    extern: true,
  },
  {
    label: 'E-Mail',
    wert: FIRMA.email,
    text: 'Schreiben Sie uns Ihr Anliegen per E-Mail.',
    href: `mailto:${FIRMA.email}`,
    aktion: 'E-Mail schreiben',
    symbol: 'brief',
    extern: false,
  },
  {
    label: 'Adresse',
    wert: FIRMA.name,
    text: `Friedrich-Ebert-Str. 8, ${FIRMA.plz} ${FIRMA.ort}`,
    href: HILFE.routeZiel,
    aktion: 'Route anzeigen',
    symbol: 'nadel',
    extern: true,
  },
];
---

<Grundlage
  titel="Hilfe und Kontakt | Taxi Germersheim GmbH"
  beschreibung="Alle Kontaktwege zur Taxi Germersheim GmbH und Antworten auf häufige Fragen zu Buchung, Änderung, Stornierung, Krankenfahrten und Rewards."
  pfad="hilfe-kontakt.html"
>
  <Sprungmarken />
  <Kopfbereich startseite={false} />

  <main id="inhalt" class="pt-16 lg:pt-20">
    <Unterseitenkopf label={HILFE.label} titel={HILFE.titel} text={HILFE.text} />

    {/* ══ Kontaktwege ═══════════════════════════════════════════════════ */}
    <section aria-labelledby="kontakt-titel" class="mx-auto w-full max-w-[1400px] px-5 lg:px-10 pt-12 lg:pt-16">
      <Enthuellen>
        <div>
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-primary">{HILFE.kontaktLabel}</p>
          <h2 id="kontakt-titel" class="mt-3 font-semibold tracking-[-0.02em] text-foreground leading-tight" style="font-size: clamp(1.5rem, 2.6vw, 2.25rem)">
            {HILFE.kontaktTitel}
          </h2>
        </div>
      </Enthuellen>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {wege.map((w, i) => (
          <Enthuellen verzoegerung={i * 60} class="h-full">
            <div class="h-full bg-card border border-border p-6 flex flex-col">
              <span class="w-10 h-10 rounded-full bg-primary/12 text-primary flex items-center justify-center">
                <Symbol name={w.symbol} class="w-[18px] h-[18px]" />
              </span>
              <p class="mt-5 text-[11px] uppercase tracking-[0.18em] text-muted-foreground/70">{w.label}</p>
              <p class="mt-1.5 font-semibold text-foreground leading-snug break-words">{w.wert}</p>
              <p class="mt-2 text-sm text-muted-foreground flex-1">{w.text}</p>
              <a
                href={w.href}
                target={w.extern ? '_blank' : undefined}
                rel={w.extern ? 'noreferrer' : undefined}
                class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-foreground hover:text-primary transition-colors duration-150 tg-press"
              >
                {w.aktion}
                <Symbol name="pfeil" class="w-4 h-4" />
              </a>
            </div>
          </Enthuellen>
        ))}
      </div>
    </section>

    {/* ══ Haeufige Fragen ═══════════════════════════════════════════════ */}
    <section aria-labelledby="fragen-titel" class="mx-auto w-full max-w-[1400px] px-5 lg:px-10 pt-20 lg:pt-28">
      <div class="grid lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] gap-10 lg:gap-16">
        <Enthuellen>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-primary">{HILFE.fragenLabel}</p>
            <h2 id="fragen-titel" class="mt-3 font-semibold tracking-[-0.02em] text-foreground leading-tight" style="font-size: clamp(1.5rem, 2.6vw, 2.25rem)">
              {HILFE.fragenTitel}
            </h2>
          </div>
        </Enthuellen>

        <Enthuellen verzoegerung={80}>
          <ul class="border-t border-border tg-fragen">
            {FAQ_HILFE.map((f) => (
              <li class="border-b border-border">
                <details>
                  <summary class="w-full flex items-start justify-between gap-6 py-5 cursor-pointer list-none">
                    <span class="font-medium text-foreground text-[16px] leading-snug">{f.frage}</span>
                    <span aria-hidden="true" class="shrink-0 mt-0.5 text-primary transition-transform duration-[220ms] tg-fragen-zeichen">
                      <Symbol name="plus" class="w-4 h-4" />
                    </span>
                  </summary>
                  {/* max-w-[46em]: sonst laeuft die Antwort auf breiten
                      Bildschirmen ueber rund 90 Zeichen je Zeile. */}
                  <p class="pb-5 pr-10 max-w-[46em] text-[15px] leading-relaxed text-muted-foreground">{f.antwort}</p>
                </details>
              </li>
            ))}
          </ul>
        </Enthuellen>
      </div>
    </section>

    {/* ══ Rechtliches ═══════════════════════════════════════════════════ */}
    <section aria-labelledby="recht-titel" class="mx-auto w-full max-w-[1400px] px-5 lg:px-10 py-20 lg:py-28">
      <Enthuellen>
        <div class="bg-card border border-border p-7 lg:p-9 flex flex-wrap items-center justify-between gap-6">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-primary">{HILFE.rechtLabel}</p>
            <h2 id="recht-titel" class="mt-3 text-[22px] lg:text-[26px] font-semibold text-foreground leading-tight">
              {HILFE.rechtTitel}
            </h2>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="datenschutz.html" class="inline-flex items-center gap-2 border border-border px-5 py-3 text-sm font-medium text-foreground hover:border-primary hover:text-primary transition-colors duration-150 tg-press">
              {DATENSCHUTZ.titel}
              <Symbol name="pfeil" class="w-4 h-4" />
            </a>
            <a href="impressum.html" class="inline-flex items-center gap-2 border border-border px-5 py-3 text-sm font-medium text-foreground hover:border-primary hover:text-primary transition-colors duration-150 tg-press">
              {IMPRESSUM.titel}
              <Symbol name="pfeil" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </Enthuellen>
    </section>
  </main>

  <Fusszeile startseite={false} />
</Grundlage>

<style>
  /* Den Browser-Pfeil vor <summary> abschalten - das Pluszeichen rechts
     uebernimmt die Anzeige. Safari braucht dafuer den eigenen Selektor. */
  .tg-fragen summary::-webkit-details-marker {
    display: none;
  }
  .tg-fragen summary::marker {
    content: '';
  }

  /* Geoeffnet: aus dem Plus wird ein Kreuz. Nur die Drehung, kein Austausch
     des Symbols - das bliebe sonst bei reduzierter Bewegung stehen. */
  .tg-fragen details[open] .tg-fragen-zeichen {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-fragen-zeichen {
      transition: none;
    }
  }
</style>
