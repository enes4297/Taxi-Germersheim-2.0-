---
/**
 * Kontakt und haeufige Fragen — helle Flaeche.
 * Uebernommen aus sections.tsx der Vorschau.
 */
import { FAQ, FIRMA, KONTAKT_KOPF } from '../inhalte';
import Abschnitt from './Abschnitt.astro';
import AbschnittKopf from './AbschnittKopf.astro';
import Enthuellen from './Enthuellen.astro';
import Symbol from './Symbol.astro';

const wege = [
  { titel: 'Telefon', wert: FIRMA.telefon, text: 'Rufen Sie uns direkt an.', href: FIRMA.telefonLink, aktion: 'Jetzt anrufen', symbol: 'telefon', extern: false },
  { titel: 'WhatsApp', wert: 'Direkt schreiben', text: 'Schreiben Sie uns direkt über WhatsApp Business.', href: FIRMA.whatsapp, aktion: 'WhatsApp öffnen', symbol: 'whatsapp', extern: true },
  { titel: 'E-Mail', wert: FIRMA.email, text: 'Schreiben Sie uns Ihr Anliegen per E-Mail.', href: `mailto:${FIRMA.email}`, aktion: 'E-Mail schreiben', symbol: 'brief', extern: false },
  { titel: 'Adresse', wert: `${FIRMA.strasse}, ${FIRMA.plz} ${FIRMA.ort}`, text: FIRMA.name, href: null, aktion: null, symbol: 'nadel', extern: false },
];
---

<Abschnitt id="kontakt" hell>
  <Enthuellen>
    <AbschnittKopf hell label={KONTAKT_KOPF.label} titel={KONTAKT_KOPF.titel} text={KONTAKT_KOPF.text} />
  </Enthuellen>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {wege.map((w, i) => (
      <Enthuellen verzoegerung={i * 60} class="h-full">
        <div class="h-full bg-white/70 border border-black/10 p-6 flex flex-col">
          <span class="w-10 h-10 rounded-full bg-[#17171a] text-[#c8a96e] flex items-center justify-center">
            <Symbol name={w.symbol} class="w-[18px] h-[18px]" />
          </span>
          <h3 class="mt-5 text-[11px] uppercase tracking-[0.18em] text-[#9a9184]">{w.titel}</h3>
          <p class="mt-1.5 font-semibold text-[#17171a] leading-snug break-words">{w.wert}</p>
          <p class="mt-2 text-sm text-[#5c554a] flex-1">{w.text}</p>
          {w.href && (
            <a
              href={w.href}
              target={w.extern ? '_blank' : undefined}
              rel={w.extern ? 'noreferrer' : undefined}
              class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-[#17171a] hover:text-[#8a7a52] tg-press"
            >
              {w.aktion}
              <Symbol name="pfeil" class="w-4 h-4" />
            </a>
          )}
        </div>
      </Enthuellen>
    ))}
  </div>

  {/* Haeufige Fragen */}
  <div class="mt-20 grid lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] gap-10 lg:gap-16">
    <Enthuellen>
      <div>
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-[#8a7a52]">Gut zu wissen</p>
        <h3 class="mt-4 font-semibold tracking-[-0.02em] text-[#17171a] leading-tight" style="font-size: clamp(1.5rem, 2.4vw, 2.25rem)">Häufige Fragen</h3>
      </div>
    </Enthuellen>

    <Enthuellen verzoegerung={80}>
      <ul class="border-t border-black/10" data-faq>
        {FAQ.map((f, i) => (
          <li class="border-b border-black/10">
            <h4>
              <button
                type="button"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`faq-${i}`}
                class="w-full flex items-start justify-between gap-6 py-5 text-left"
                data-faq-knopf={i}
              >
                <span class="font-medium text-[#17171a] text-[16px] leading-snug">{f.frage}</span>
                <span aria-hidden="true" class="shrink-0 mt-0.5 text-[#8a7a52] transition-transform duration-[220ms]" style={i === 0 ? 'transform: rotate(45deg)' : ''} data-faq-zeichen>
                  <Symbol name="plus" class="w-4 h-4" />
                </span>
              </button>
            </h4>
            {/* Hoehenuebergang ueber grid-template-rows: kein Messen, kein
                Springen, jederzeit unterbrechbar. */}
            <div
              id={`faq-${i}`}
              class="grid transition-[grid-template-rows,opacity] duration-[260ms] ease-[cubic-bezier(0.32,0.72,0,1)]"
              style={`grid-template-rows: ${i === 0 ? '1fr' : '0fr'}; opacity: ${i === 0 ? 1 : 0}`}
              data-faq-inhalt
            >
              <div class="overflow-hidden">
                <p class="pb-5 pr-10 text-[15px] leading-relaxed text-[#5c554a]">{f.antwort}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </Enthuellen>
  </div>
</Abschnitt>

<script>
  const liste = document.querySelector<HTMLElement>('[data-faq]');
  if (liste) {
    const knoepfe = [...liste.querySelectorAll<HTMLButtonElement>('[data-faq-knopf]')];
    let offen: number | null = 0;
    const zeichnen = () => {
      knoepfe.forEach((k, i) => {
        const auf = offen === i;
        k.setAttribute('aria-expanded', String(auf));
        k.querySelector<HTMLElement>('[data-faq-zeichen]')!.style.transform = auf ? 'rotate(45deg)' : '';
        const inhalt = k.closest('li')!.querySelector<HTMLElement>('[data-faq-inhalt]')!;
        inhalt.style.gridTemplateRows = auf ? '1fr' : '0fr';
        inhalt.style.opacity = auf ? '1' : '0';
      });
    };
    knoepfe.forEach((k, i) => k.addEventListener('click', () => { offen = offen === i ? null : i; zeichnen(); }));
  }
</script>
