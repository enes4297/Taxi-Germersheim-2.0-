---
/**
 * Die Kartenreihe der Rechtsseiten (Impressum, Datenschutz).
 *
 * Entspricht `legal-content-grid` des Bestands, aber mit den Farben,
 * Schriften und Abstaenden der freigegebenen Gestaltung. Eine Karte je
 * Angabe - das haelt lange Rechtstexte auf dem Handy lesbar, weil jede
 * Karte fuer sich umbricht.
 *
 * Der TEXT kommt unveraendert aus inhalte.ts. Diese Datei entscheidet nur,
 * wie er aussieht.
 */
import type { Rechtskarte } from '../inhalte';
import Enthuellen from './Enthuellen.astro';

interface Props {
  karten: readonly Rechtskarte[];
}
const { karten } = Astro.props;
---

<div class="mt-12 lg:mt-16 grid gap-5 sm:grid-cols-2">
  {karten.map((k, i) => (
    <Enthuellen verzoegerung={Math.min(i, 6) * 50} class={k.breit ? 'sm:col-span-2' : ''}>
      <article class="h-full bg-card border border-border p-6 lg:p-8">
        <p class="text-[11px] font-semibold tracking-[0.22em] uppercase text-primary">{k.label}</p>
        <h2 class="mt-3 text-[19px] lg:text-[21px] font-semibold text-foreground leading-snug">{k.titel}</h2>

        {/*
          `max-w-[46em]` begrenzt die Zeilenlaenge. Das betrifft nur die
          breiten Karten, die ueber beide Spalten gehen - ohne Begrenzung
          liefe ihr Text auf grossen Bildschirmen ueber die volle
          Seitenbreite, gemessen 84 em. Bei rund 90 Zeichen je Zeile
          verliert man beim Zurueckspringen die Zeile.
        */}
        {k.zeilen && (
          <p class="mt-4 max-w-[46em] text-[15px] leading-[1.75] text-muted-foreground">
            {k.zeilen.map((z, n) => (
              <>
                {n > 0 && <br />}
                {z}
              </>
            ))}
          </p>
        )}

        {k.werte && (
          <dl class="mt-4 space-y-3.5">
            {k.werte.map((w) => (
              <div>
                {/*
                  Die Beschriftung steht bewusst in NORMALER Schreibweise.
                  Im Bestand hiess es „Registergericht", nicht
                  „REGISTERGERICHT" - und bei einer Registerangabe ist die
                  Schreibweise Teil dessen, was dort steht. Die
                  Versalschreibung bleibt den Abschnittslabeln vorbehalten.
                  Der Prueflauf vergleicht Zeichen fuer Zeichen gegen die
                  alte Fassung und hat den Unterschied gemeldet.
                */}
                {w.name && (
                  <dt class="text-[12px] font-medium tracking-[0.01em] text-muted-foreground/75">{w.name}</dt>
                )}
                <dd class={w.name ? 'mt-1' : ''}>
                  {w.href ? (
                    <a
                      href={w.href}
                      class="text-[15px] text-foreground hover:text-primary transition-colors duration-150 break-words"
                    >
                      {w.wert}
                    </a>
                  ) : (
                    <span class="text-[15px] text-foreground break-words">{w.wert}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </article>
    </Enthuellen>
  ))}
</div>
