---
/**
 * Region — Bildband als Rhythmuswechsel.
 * Uebernommen aus sections.tsx der Vorschau.
 */
import { REGION } from '../inhalte';
import Enthuellen from './Enthuellen.astro';
---

<section id="region" class="relative overflow-hidden" style="scroll-margin-top: 5rem">
  {/* Das Rollstuhlfahrzeug liegt als einziges Motiv im 3:2-Format vor und
      vertraegt den breiten Beschnitt am besten. */}
  <img
    src="/assets/fleet/vw-rollstuhlfahrzeug-1600.jpg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover tg-vehicle"
    style="object-position: 50% 58%"
  />
  {/* Kraeftiger als im Hero: Hier liegt zusammenhaengender Fliesstext auf dem
      Bild, keine einzelne grosse Ueberschrift. Die Fahrzeugfront rechts
      bleibt frei. */}
  <div
    aria-hidden="true"
    class="absolute inset-0"
    style="background: linear-gradient(100deg, rgba(20,20,23,0.97) 0%, rgba(20,20,23,0.94) 34%, rgba(20,20,23,0.80) 50%, rgba(20,20,23,0.30) 74%, rgba(20,20,23,0.18) 100%)"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1400px] px-5 lg:px-10 py-24 lg:py-32">
    <Enthuellen>
      <div>
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-primary">{REGION.label}</p>
        <div class="mt-6 font-semibold tracking-[-0.025em] leading-[1.12] text-white max-w-2xl" style="font-size: clamp(1.75rem, 3.1vw, 3rem)">
          {REGION.zeilen.map((z, i) => (
            <p
              class={i === REGION.zeilen.length - 1 ? 'text-primary' : undefined}
              style={`animation: tg-fade-rise 640ms cubic-bezier(0.16,1,0.3,1) ${i * 110}ms both`}
            >
              {z}
            </p>
          ))}
        </div>
      </div>
    </Enthuellen>

    {/* Der gesamte Textblock bleibt in der linken Haelfte. Die Ortschips
        liefen sonst ueber die helle Fahrzeugfront und waren dort nicht
        lesbar. */}
    <Enthuellen verzoegerung={120}>
      <div class="mt-12 flex items-start gap-8 lg:gap-12 flex-wrap max-w-[46rem]">
        <div>
          <p class="text-[11px] uppercase tracking-[0.2em] text-white/45">Postleitzahl</p>
          <p class="mt-1.5 text-4xl lg:text-5xl font-semibold tabular-nums text-white tracking-tight">{REGION.plz}</p>
        </div>
        <ul class="flex flex-wrap gap-2 max-w-md pt-1">
          {REGION.orte.map((o) => (
            <li class="px-3.5 py-1.5 rounded-full text-sm text-white/80 bg-white/[0.08] ring-1 ring-white/10 backdrop-blur-sm">{o}</li>
          ))}
        </ul>
      </div>
    </Enthuellen>
  </div>
</section>
