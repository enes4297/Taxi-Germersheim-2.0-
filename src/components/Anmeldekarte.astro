---
/**
 * Der Rahmen der vier Anmeldeseiten.
 *
 * Eine schmale, mittig stehende Karte - so wie im Bestand, nur in der
 * freigegebenen Gestaltung. Bewusst OHNE die grosse Bildspalte der alten
 * anmelden.html: Die drei Stichpunkte darin („Fahrten im Blick behalten"
 * und so fort) standen auf dem Handy in einer rund 60 Punkte schmalen
 * Spalte, ein Wort je Zeile. Sie stehen jetzt unter dem Formular, wo sie
 * lesbar sind.
 *
 * `schmal` haelt die Karte eng (Anmeldung, Passwort). Die Registrierung
 * braucht mehr Platz, weil dort zwei Felder nebeneinander stehen.
 */
import Symbol from './Symbol.astro';

interface Props {
  label: string;
  titel: string;
  text?: string;
  /** Beschriftung ueber dem Formular, wie im Bestand. */
  formularTitel?: string;
  formularText?: string;
  schmal?: boolean;
  /** Fusszeile der Karte: „Noch kein Konto?" und dergleichen. */
  hinweis?: string;
  hinweisZiel?: string;
  hinweisText?: string;
  /** Die Zeile ganz unten - im Bestand stand dort ein Sicherheitshinweis. */
  fusstext?: string;
}
const {
  label, titel, text, formularTitel, formularText,
  schmal = true, hinweis, hinweisZiel, hinweisText, fusstext,
} = Astro.props;
---

<div class={`mx-auto w-full px-5 lg:px-10 py-12 lg:py-16 ${schmal ? 'max-w-[34rem]' : 'max-w-[46rem]'}`}>
  <a
    href="index.html"
    class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors duration-150"
  >
    <span aria-hidden="true">←</span> Startseite
  </a>

  <div class="mt-8">
    <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-primary">{label}</p>
    <h1
      class="mt-3 font-semibold tracking-[-0.03em] leading-[1.06] text-foreground"
      style="font-size: clamp(1.9rem, 3.6vw, 2.75rem)"
    >
      {titel}
    </h1>
    {text && <p class="mt-4 text-[15px] leading-relaxed text-muted-foreground">{text}</p>}
  </div>

  <div class="mt-8 bg-card border border-border p-6 lg:p-8">
    {formularTitel && (
      <div class="mb-7">
        <h2 class="text-[19px] font-semibold text-foreground leading-snug">{formularTitel}</h2>
        {formularText && <p class="mt-1.5 text-sm text-muted-foreground">{formularText}</p>}
      </div>
    )}

    <slot />

    {hinweis && hinweisZiel && (
      <p class="mt-7 pt-6 border-t border-border text-sm text-muted-foreground">
        {hinweis}{' '}
        <a href={hinweisZiel} class="font-medium text-foreground hover:text-primary transition-colors duration-150 underline underline-offset-4 decoration-border">
          {hinweisText}
        </a>
      </p>
    )}
  </div>

  <slot name="unten" />

  {fusstext && (
    <p class="mt-8 flex items-start gap-2.5 text-xs leading-relaxed text-muted-foreground/80">
      <Symbol name="haken" class="w-4 h-4 shrink-0 mt-px text-primary/70" />
      <span>{fusstext}</span>
    </p>
  )}
</div>
